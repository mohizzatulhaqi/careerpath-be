{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            a.id,\n            a.admin_id,\n            u.name  AS admin_name,\n            u.email AS admin_email,\n            a.action,\n            a.target_type,\n            a.target_id,\n            a.metadata,\n            a.created_at\n        FROM admin_audit_logs a\n        JOIN users u ON u.id = a.admin_id\n        WHERE a.target_type = $1 AND a.target_id = $2\n        ORDER BY a.created_at DESC\n        LIMIT $3 OFFSET $4\n        ",
