{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            ps.project_id,\n            p.title AS project_title,\n            ps.status,\n            ps.submitted_at\n        FROM project_submissions ps\n        JOIN projects p ON p.id = ps.project_id\n        WHERE ps.user_id = $1\n        ORDER BY ps.submitted_at DESC\n        ",
