{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            srh.id,\n            srh.old_status,\n            srh.new_status,\n            srh.reviewer_notes,\n            srh.created_at,\n            u.id   AS reviewer_id,\n            u.name AS reviewer_name\n        FROM submission_review_history srh\n        JOIN users u ON u.id = srh.reviewed_by\n        WHERE srh.submission_id = $1\n        ORDER BY srh.created_at ASC\n        ",
