{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, code, name, description, is_active, created_at,\n               COUNT(*) OVER() AS \"total!: i64\"\n        FROM roles\n        WHERE\n            ($1::bool IS NULL OR is_active = $1)\n            AND ($2::text IS NULL OR name ILIKE $2 OR code ILIKE $2)\n        ORDER BY code\n        ",
