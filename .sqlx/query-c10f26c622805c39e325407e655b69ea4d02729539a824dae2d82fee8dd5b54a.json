  "query": "\n        UPDATE users\n        SET\n            name       = COALESCE($2, name),\n            email      = COALESCE($3, email),\n            updated_at = NOW()\n        WHERE id = $1\n        RETURNING id, email, name, role AS \"role: String\", is_active, created_at, updated_at\n        ",
