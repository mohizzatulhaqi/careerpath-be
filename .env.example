# ── Database ────────────────────────────────────────────────────────────────
# Credentials used by docker-compose postgres service
POSTGRES_USER=careerpath
POSTGRES_PASSWORD=careerpath_dev_password
POSTGRES_DB=career_path

# Port exposed to host (for native cargo run to connect)
POSTGRES_HOST_PORT=5432

# Connection string for cargo run on host (points to localhost)
DATABASE_URL=postgres://careerpath:careerpath_dev_password@localhost:5432/career_path

# ── pgAdmin ─────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@careerpath.local
PGADMIN_PASSWORD=admin
PGADMIN_HOST_PORT=5050

# ── JWT ─────────────────────────────────────────────────────────────────────
# REQUIRED: generate a random string of at least 32 characters
# Example: openssl rand -base64 48
JWT_SECRET=replace-with-long-random-secret-min-32-chars

# Access token TTL in seconds (default: 900 = 15 min)
JWT_EXPIRES_IN=900

# Refresh token TTL in seconds (default: 604800 = 7 days)
REFRESH_TOKEN_EXPIRES_IN=604800

# ── Server ──────────────────────────────────────────────────────────────────
SERVER_PORT=3002
APP_HOST_PORT=3002

# Log level (see tracing-subscriber EnvFilter syntax)
RUST_LOG=info,career_path_be=debug

# ── Storage ─────────────────────────────────────────────────────────────────
# Local path for uploaded project files
STORAGE_ROOT=./storage

# Max upload size in bytes (default: 26214400 = 25 MB)
MAX_UPLOAD_SIZE_BYTES=26214400
